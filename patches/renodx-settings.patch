+// Optional storage override: when set, settings are read from / written to it
+// instead of ReShade.ini (e.g. an add-on's own ini file). Values are strings.
+static std::function<bool(const std::string& section, const std::string& key, std::string& value)> config_reader = nullptr;
+static std::function<void(const std::string& section, const std::string& key, const std::string& value)> config_writer = nullptr;
+
+namespace internal_config {
+template <typename T>
+inline bool Get(const std::string& section, const std::string& key, T& value) {
+  if (config_reader == nullptr) return reshade::get_config_value(nullptr, section.c_str(), key.c_str(), value);
+  std::string text;
+  if (!config_reader(section, key, text) || text.empty()) return false;
+  char* end = nullptr;
+  if constexpr (std::is_floating_point_v<T>) {
+    value = static_cast<T>(std::strtod(text.c_str(), &end));
+  } else {
+    value = static_cast<T>(std::strtol(text.c_str(), &end, 10));
+  }
+  return end != text.c_str();
+}
+
+inline bool GetString(const std::string& section, const std::string& key, std::string& value) {
+  if (config_reader != nullptr) return config_reader(section, key, value);
+  size_t size = 0;
+  if (!reshade::get_config_value(nullptr, section.c_str(), key.c_str(), nullptr, &size) || size == 0) return false;
+  std::vector<char> temp(size + 1, '\0');
+  if (!reshade::get_config_value(nullptr, section.c_str(), key.c_str(), temp.data(), &size)) return false;
+  temp.back() = '\0';
+  value = temp.data();
+  return true;
+}
+
+template <typename T>
+inline void Set(const std::string& section, const std::string& key, const T& value) {
+  if (config_writer == nullptr) {
+    if constexpr (std::is_same_v<T, std::string>) {
+      reshade::set_config_value(nullptr, section.c_str(), key.c_str(), value.c_str());
+    } else {
+      reshade::set_config_value(nullptr, section.c_str(), key.c_str(), value);
+    }
+    return;
+  }
+  if constexpr (std::is_same_v<T, std::string> || std::is_same_v<T, const char*>) {
+    config_writer(section, key, std::string(value));
+  } else if constexpr (std::is_floating_point_v<T>) {
+    char text[64];
+    snprintf(text, sizeof(text), "%.6g", static_cast<double>(value));
+    config_writer(section, key, text);
+  } else {
+    config_writer(section, key, std::to_string(value));
+  }
+}
+}  // namespace internal_config
